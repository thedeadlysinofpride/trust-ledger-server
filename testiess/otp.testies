first request OTP

curl -X POST http://localhost:5150/api/member/auth/send-otp \
  -H "Content-Type: application/json" \
  -d '{"phone": "0532423078"}' | jq

verify otp - check logs for the debug otp

curl -X POST http://localhost:5150/api/member/auth/verify \
  -H "Content-Type: application/json" \
  -d '{"phone": "0532423078", "code": "324435"}' | jq -r '.token'

TOKEN="eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzUxMiJ9.eyJwaWQiOiI5IiwiZXhwIjoxNzgyMTIxNDUxfQ.Erl9c6laiObADidVTF99MbbuBzCyvukcBEaXbAcnmAVOspZk5r6JWLJ7XNkq9lt7IOWow5eEzavcUyBpFZEGhw"

curl -X GET http://localhost:5150/api/member/dashboard \
  -H "Authorization: Bearer $TOKEN" | jq

curl -X GET http://localhost:5150/api/groups | jq

curl -X POST http://localhost:5150/api/member/groups/join \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"code": "MKL"}' | jq

curl -X GET http://localhost:5150/api/member/groups \
  -H "Authorization: Bearer $TOKEN" | jq

curl -X GET http://localhost:5150/api/member/dashboard \
  -H "Authorization: Bearer $TOKEN" | jq

curl -X GET http://localhost:5150/api/member/groups/1 \
  -H "Authorization: Bearer $TOKEN" | jq


# Create a savings goal
curl -X POST http://localhost:5150/api/member/savings \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
    "name": "New Phone",
    "target_amount": 2000,
    "duration_days": 90,
    "frequency": "weekly",
    "mode": "loose"
  }' | jq

# List savings goals
curl -X GET http://localhost:5150/api/member/savings \
  -H "Authorization: Bearer $TOKEN" | jq

# Deposit to savings goal
curl -X POST http://localhost:5150/api/member/savings/deposit \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
    "goal_id": 1,
    "amount": 100
  }' | jq

# Withdraw from savings goal (only if mode is loose or goal is completed)
curl -X POST http://localhost:5150/api/member/savings/withdraw/1 \
  -H "Authorization: Bearer $TOKEN" | jq

curl -X GET http://localhost:5150/api/member/trust-score/history \
  -H "Authorization: Bearer $TOKEN" | jq
